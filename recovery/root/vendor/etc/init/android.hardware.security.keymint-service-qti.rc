service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/odm/lib64:/bin
    seclabel u:r:recovery:s0
    task_profiles CPUSET_SP_FOREGROUND
    disabled
