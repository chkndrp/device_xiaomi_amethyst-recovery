on boot
    start vibratorfeature-service

service vibratorfeature-service /vendor/bin/hw/vendor.xiaomi.hardware.vibratorfeature.service
    user root
    group root system input audio
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/vendor/odm/lib64:/bin
    seclabel u:r:recovery:s0
    task_profiles CPUSET_SP_TOP_APP
    priority -5
    ioprio rt 5
    disabled
